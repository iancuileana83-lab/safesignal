# Copy to .env and fill in yourself. Never commit .env.

# --- Model endpoint (any OpenAI-compatible server) ---
# Local stand-in (npm run standin):   http://localhost:8001/v1
# AMD vLLM on the droplet:            http://<DROPLET_IP>:8000/v1
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
# Leave empty to use the first model the server lists
LLM_MODEL=

# What the endpoint really is. The UI badge and the recorder depend on this.
#   standin = temporary local substitute (never shown as AMD)
#   amd     = vLLM on AMD Instinct (the only kind that can be recorded as a replay)
BACKEND_KIND=standin
BACKEND_LABEL=local stand-in
# Shown in the badge, e.g. "AMD Instinct MI300X · ROCm · vLLM"
HARDWARE_LABEL=

PORT=3000
