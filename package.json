{
  "name": "safesignal",
  "version": "0.1.0",
  "description": "Helps complete and triage a suspected medicine side-effect report before a human reviews it. Demo only.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "standin": "node tools/standin.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node --env-file-if-exists=.env tools/bench.mjs",
    "record": "node --env-file-if-exists=.env tools/record.mjs",
    "build:static": "node tools/build-static.mjs"
  }
}
